{
  "id": "./",
  "name": "Lofi Studio Pro",
  "short_name": "Lofi Studio",
  "description": "A 16-step lofi beat machine that runs entirely in your browser: six tracks, ten patterns, twelve chord sets, nine ambience layers and a live tape chain.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#12101a",
  "theme_color": "#12101a",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "music",
    "entertainment",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The sequencer on a phone"
    },
    {
      "src": "screenshots/desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Studio view on desktop"
    }
  ],
  "shortcuts": [
    {
      "name": "Focus beat",
      "short_name": "Focus",
      "url": "./?preset=focus",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Sleep ambience",
      "short_name": "Sleep",
      "url": "./?preset=sleep",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}